---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <main style="background-color: #1c1917; color: white; min-height: 100vh;">
        <section style="position: relative; padding: 140px 24px; text-align: center; overflow: hidden;">
            <div style="position: absolute; inset: 0; opacity: 0.3; background-image: url('https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?q=80&w=2070&auto=format&fit=crop'); background-size: cover; background-position: center;"></div>
            <div style="position: relative; z-index: 10;">
                <span style="color: #f59e0b; text-transform: uppercase; letter-spacing: 0.3em; font-size: 0.75rem;">The Spirits</span>
                <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(3rem, 8vw, 5rem); margin-top: 10px; font-style: italic;">Libations</h1>
            </div>
        </section>

        <section style="max-width: 1100px; margin: 0 auto; padding: 80px 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 60px;">
            
            <div>
                <h2 style="font-family: 'Playfair Display', serif; color: #b45309; border-bottom: 1px solid #44403c; padding-bottom: 15px; margin-bottom: 30px; text-transform: uppercase; font-size: 1.2rem;">Signature Cocktails</h2>
                {[
                    { name: "The Milltown Old Fashioned", price: "14", desc: "Bourbon, sorghum syrup, black walnut bitters, expressed orange" },
                    { name: "Carolina Gold", price: "13", desc: "Vodka, fresh turmeric, ginger, lemon, honey, sparkling water" },
                    { name: "Spartanburg Spritz", price: "12", desc: "Aperol, peach nectar, prosecco, fresh thyme" }
                ].map(drink => (
                    <div style="margin-bottom: 25px;">
                        <div style="display: flex; justify-content: space-between; font-family: 'Inter', sans-serif; font-weight: 600;">
                            <span>{drink.name}</span>
                            <span>{drink.price}</span>
                        </div>
                        <p style="font-size: 0.85rem; color: #a8a29e; margin-top: 5px; font-style: italic;">{drink.desc}</p>
                    </div>
                ))}
            </div>

            <div>
                <h2 style="font-family: 'Playfair Display', serif; color: #b45309; border-bottom: 1px solid #44403c; padding-bottom: 15px; margin-bottom: 30px; text-transform: uppercase; font-size: 1.2rem;">Local Craft Beer</h2>
                <div style="font-family: 'Inter', sans-serif; line-height: 2;">
                    <p style="display: flex; justify-content: space-between;"><span>Holiday Brewing IPA</span> <span>7</span></p>
                    <p style="display: flex; justify-content: space-between;"><span>RJ Rockers Son of a Peach</span> <span>6</span></p>
                    <p style="display: flex; justify-content: space-between;"><span>Plankowner Pale Ale</span> <span>7</span></p>
                    <p style="display: flex; justify-content: space-between;"><span>New South White Ale</span> <span>6</span></p>
                </div>
            </div>

        </section>
    </main>
</Layout>