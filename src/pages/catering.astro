---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <main style="background-color: #ffffff; color: #1c1917; min-height: 100vh;">
        <section style="background-color: #f5f5f4; padding: 100px 24px; text-align: center;">
            <div style="max-width: 800px; margin: 0 auto;">
                <h1 style="font-family: 'Playfair Display', serif; font-size: 3.5rem; margin-bottom: 20px;">Catering & Events</h1>
                <p style="font-family: 'Inter', sans-serif; font-size: 1.2rem; color: #44403c; line-height: 1.6;">Bring the Heirloom experience to your next gathering. From corporate lunches to intimate weddings, we provide elevated Southern comfort anywhere in the Upstate.</p>
            </div>
        </section>

        <section style="max-width: 1000px; margin: 0 auto; padding: 80px 24px; display: flex; flex-wrap: wrap; gap: 40px;">
            <div style="flex: 1; min-width: 280px; padding: 30px; border: 1px solid #e7e5e4;">
                <h3 style="font-family: 'Playfair Display', serif; color: #b45309; margin-bottom: 15px;">Private Dining</h3>
                <p style="font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #78716c;">Our semi-private mill-view room is perfect for groups of up to 20 guests.</p>
            </div>
            <div style="flex: 1; min-width: 280px; padding: 30px; border: 1px solid #e7e5e4;">
                <h3 style="font-family: 'Playfair Display', serif; color: #b45309; margin-bottom: 15px;">Off-Site Catering</h3>
                <p style="font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #78716c;">Full-service catering for events at your home, office, or local venue.</p>
            </div>
        </section>

        <section style="text-align: center; padding-bottom: 100px;">
            <p style="font-family: 'Inter', sans-serif; font-weight: bold; text-transform: uppercase; letter-spacing: 0.1em;">Ready to plan your event?</p>
            <a href="mailto:events@heirloomeatery.com" style="display: inline-block; margin-top: 20px; padding: 15px 40px; background-color: #1c1917; color: white; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 0.8rem; font-weight: bold; text-transform: uppercase;">Inquire Today</a>
        </section>
    </main>
</Layout>