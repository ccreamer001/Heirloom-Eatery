---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <main style="background-color: #f5f5f4; color: #1c1917; min-height: 100vh;">
        <section style="padding: 100px 24px; text-align: center; background-color: #1c1917; color: white;">
            <span style="color: #f59e0b; text-transform: uppercase; letter-spacing: 0.3em; font-size: 0.75rem;">Get in Touch</span>
            <h1 style="font-family: 'Playfair Display', serif; font-size: 3.5rem; margin-top: 10px; font-style: italic;">Contact Us</h1>
        </section>

        <section style="max-width: 1100px; margin: 0 auto; padding: 80px 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 60px;">
            
            <div style="font-family: 'Inter', sans-serif;">
                <div style="margin-bottom: 40px;">
                    <h2 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; margin-bottom: 15px; color: #b45309;">Location</h2>
                    <p style="color: #44403c; line-height: 1.6;">
                        101 Kennedy St<br />
                        Spartanburg, SC 29306
                    </p>
                    <a href="https://maps.app.goo.gl/example" target="_blank" style="color: #b45309; text-decoration: none; font-size: 0.8rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.1em; display: inline-block; margin-top: 10px;">Get Directions</a>
                </div>

                <div style="margin-bottom: 40px;">
                    <h2 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; margin-bottom: 15px; color: #b45309;">Hours</h2>
                    <div style="color: #44403c; line-height: 1.8;">
                        <p style="display: flex; justify-content: space-between;"><span>Mon – Thu</span> <span>5pm – 9pm</span></p>
                        <p style="display: flex; justify-content: space-between;"><span>Fri – Sat</span> <span>5pm – 9:30pm</span></p>
                        <p style="display: flex; justify-content: space-between;"><span>Sunday</span> <span>5pm – 9pm</span></p>
                    </div>
                </div>

                <div>
                    <h2 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; margin-bottom: 15px; color: #b45309;">Reach Out</h2>
                    <p style="color: #44403c;">(864) 555-0123</p>
                    <p style="color: #44403c;">hello@heirloomeatery.com</p>
                </div>
            </div>

            <div style="background-color: #e7e5e4; height: 450px; position: relative; border: 1px solid #d6d3d1;">
                <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20px;">
                    <p style="font-family: 'Inter', sans-serif; font-size: 0.8rem; color: #78716c; text-transform: uppercase; letter-spacing: 0.1em;">
                        [Interactive Google Map Embed Goes Here]
                    </p>
                </div>
            </div>

        </section>
    </main>
</Layout>